# Public-facing reverse proxy for Keycloak: forwards realm/OIDC endpoints, blocks the admin
# console + Admin REST API + master-realm auth so this is the only Keycloak port anyone
# tunnels or exposes publicly. Keycloak's own port stays reachable only on the host/compose
# network for actual admin work.
:{$KEYCLOAK_PUBLIC_PORT:8181} {
	@admin {
		path /admin*
		path /realms/master*
	}
	respond @admin 404

	# This proxy's own listener is plain HTTP, so Caddy would otherwise stamp
	# X-Forwarded-Proto: http, ignoring that everything reaching it (a tunnel now, an ALB
	# later) already terminated real TLS one hop earlier. Keycloak trusts that header
	# (KC_PROXY_HEADERS=xforwarded) to build its issuer/endpoint URLs, so getting this wrong
	# breaks OIDC discovery for every client.
	reverse_proxy keycloak:{$KEYCLOAK_PORT:8180} {
		header_up X-Forwarded-Proto https
	}
}
