# Raw Postgres passthrough for magic-boto — plain TCP, no TLS at this layer (nginx stream can't
# route by hostname without SNI-preread, which Postgres's wire protocol doesn't speak; each DB
# just gets its own port instead). allow/deny is the same gate as the admin HTTP vhosts in
# ../conf.d/magicboto.conf.template.
#
# Requires a top-level `stream { include /etc/nginx/stream.conf.d/*.conf; }` block in
# /etc/nginx/nginx.conf (one-time manual edit, sibling to the existing `http { ... }` block, not
# inside it) — this nginx build already has --with-stream compiled in. See
# docs/LIGHTSAIL-DEPLOY.md.
server {
    listen ${POSTGRES_APP_PUBLIC_PORT};
    proxy_pass 127.0.0.1:5432; # app postgres
    allow ${ADMIN_ALLOWED_IP};
    deny all;
}

server {
    listen ${POSTGRES_KEYCLOAK_PUBLIC_PORT};
    proxy_pass 127.0.0.1:5433; # keycloak_postgres
    allow ${ADMIN_ALLOWED_IP};
    deny all;
}
