# HTTP vhosts for magic-boto on the shared rundotgames.xyz nginx (nginx.org package — conf.d
# layout, no sites-available/sites-enabled). Render with envsubst and drop at
# /etc/nginx/conf.d/magicboto.conf. See docs/LIGHTSAIL-DEPLOY.md.
#
# ssl_certificate lines start pointed at the box's placeholder snakeoil cert (same as the
# existing /etc/nginx/conf.d/default.conf) purely so nginx has something valid to load before
# real certs exist. `certbot --nginx -d ... -d ...` (see docs) rewrites those two lines per
# domain in place, exactly like it already did for the rundotgames.xyz block.
#
# Reaches every backend via 127.0.0.1 because docker-compose.yml binds every service's published
# port to loopback.

# Public — no IP restriction. keycloak_public_proxy already blocks /admin* and /realms/master*
# itself (see keycloak/Caddyfile), so it's safe to expose broadly.
server {
    listen 443 ssl;
    server_name ${MCP_DOMAIN};
    ssl_certificate     /etc/ssl/certs/ssl-cert-snakeoil.pem;
    ssl_certificate_key /etc/ssl/private/ssl-cert-snakeoil.key;

    location / {
        proxy_pass http://127.0.0.1:8765; # tools_mcp
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl;
    server_name ${KEYCLOAK_DOMAIN};
    ssl_certificate     /etc/ssl/certs/ssl-cert-snakeoil.pem;
    ssl_certificate_key /etc/ssl/private/ssl-cert-snakeoil.key;

    location / {
        proxy_pass http://127.0.0.1:8181; # keycloak_public_proxy
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# Admin-only from here down — allow/deny is the only gate. Update ADMIN_ALLOWED_IP, re-render,
# `sudo systemctl reload nginx` whenever your IP changes.
server {
    listen 443 ssl;
    server_name ${KEYCLOAK_ADMIN_DOMAIN};
    ssl_certificate     /etc/ssl/certs/ssl-cert-snakeoil.pem;
    ssl_certificate_key /etc/ssl/private/ssl-cert-snakeoil.key;
    allow ${ADMIN_ALLOWED_IP};
    deny all;

    location / {
        proxy_pass http://127.0.0.1:8180; # keycloak's own port: admin console + REST API
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 443 ssl;
    server_name ${FLOWER_DOMAIN};
    ssl_certificate     /etc/ssl/certs/ssl-cert-snakeoil.pem;
    ssl_certificate_key /etc/ssl/private/ssl-cert-snakeoil.key;
    allow ${ADMIN_ALLOWED_IP};
    deny all;

    location / {
        proxy_pass http://127.0.0.1:5555; # flower
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
