.env

# dev/ tunnel script logs
dev/.tunnel-logs/

# rendered nginx config (envsubst output) — the .template sources are what's tracked
nginx/conf.d/magicboto.conf
nginx/stream.conf.d/magicboto-postgres.conf

# regenerated Keycloak client secrets (deploy/lightsail-deploy.sh) — never commit these
.keycloak-client-secrets

# tools-ui build artifacts
tools-ui/node_modules/
tools-ui/dist/
tools_api/app/mcp_tooling/ui_dist/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
