# Copy to .env and adjust. This project does not load .env at runtime; set these variables in the
# environment (Docker Compose, your shell, CI, etc.) before running docker-compose, DB tasks, or tools_api.

# Tools API: container port (default 8000). Host port = TOOLS_API_LOCAL_PORT.
# TOOLS_API_PORT=8000
# TOOLS_API_LOCAL_PORT=8000
# MCP streamable HTTP: ``uv run uvicorn app.cmd.serve_mcp.asgi:app`` (Docker Compose tools_mcp).
# Path defaults to /mcp (e.g. http://localhost:8765/mcp for MCP Inspector or desktop clients).
# TOOLS_MCP_HOST=0.0.0.0
# TOOLS_MCP_PORT=8765
# Browser MCP clients: comma-separated CORS origins, or * (default).
# TOOLS_MCP_CORS_ORIGINS=*
# Stdio MCP (local subprocess hosts only): uv run python -m app.cmd.serve_mcp.stdio
# Host map for tools_mcp container (default 8765).
# TOOLS_MCP_LOCAL_PORT=8765
# MCP server id when registering this server in a host (e.g. Cursor); must match host config.
# TOOLS_MCP_SERVER_NAME=magic-boto-tools
# MCP Inspector (ghcr.io/modelcontextprotocol/inspector): host ports for UI and proxy.
# MCP_INSPECTOR_CLIENT_PORT=6274
# MCP_INSPECTOR_SERVER_PORT=6277
# After compose up: open http://localhost:${MCP_INSPECTOR_CLIENT_PORT:-6274} — use Streamable HTTP
# server URL http://tools_mcp:8765/mcp (not localhost:8765; proxy runs inside Docker).
# Logging (LOG_LEVEL=DEBUG for verbose tool requests).
# LOG_LEVEL=DEBUG
POSTGRES_HOST=localhost
POSTGRES_USER=magicboto
POSTGRES_PASSWORD=magicboto
POSTGRES_DB=magicboto
POSTGRES_PORT=5432
# Required for tag sweep/audit (Anthropic Batch API).
ANTHROPIC_API_KEY=

# Keycloak (auth). start-dev mode with its own Postgres instance (keycloak_postgres).
# CHANGE THE DEFAULT PASSWORD before exposing KEYCLOAK_PUBLIC_LOCAL_PORT via any tunnel.
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_PORT=8180
# KEYCLOAK_LOCAL_PORT=8180
# KEYCLOAK_DB_USER=keycloak
# KEYCLOAK_DB_PASSWORD=keycloak
# KEYCLOAK_DB_NAME=keycloak
# KEYCLOAK_DB_LOCAL_PORT=5433
# keycloak_public_proxy (Caddy): the ONLY Keycloak port to tunnel or expose publicly. Blocks
# /admin* and /realms/master*; passes through app-realm OIDC endpoints. Point
# KEYCLOAK_ISSUER_URL / any tunnel at this port, never at KEYCLOAK_LOCAL_PORT.
# KEYCLOAK_PUBLIC_PORT=8181
# KEYCLOAK_PUBLIC_LOCAL_PORT=8181

# MCP resource-server auth (bearer JWTs, streamable HTTP only — stdio is never gated).
# Off by default; set true once a Keycloak client is provisioned (see AGENTS.md / README).
# TOOLS_MCP_AUTH_ENABLED=false
# Externally reachable base URL of tools_mcp, used for RFC 9728 protected-resource metadata.
# TOOLS_MCP_RESOURCE_SERVER_URL=http://localhost:8765
# Comma-separated scopes required on every request (blank = accept any authenticated token).
# TOOLS_MCP_REQUIRED_SCOPES=
# Realm issuer as it appears in tokens' `iss` claim — the URL clients/tokens use, not the
# Docker-internal one.
# KEYCLOAK_ISSUER_URL=http://localhost:8180/realms/magic-boto
# Expected `aud` claim; set to the confidential client's client ID (or a mapped audience).
# KEYCLOAK_AUDIENCE=magic-boto-tools-api
# Override only if tools_mcp can't reach KEYCLOAK_ISSUER_URL directly (e.g. Compose: the
# container reaches Keycloak via its service name, not the host-mapped localhost port).
# KEYCLOAK_JWKS_URL=http://keycloak:8180/realms/magic-boto/protocol/openid-connect/certs
# KEYCLOAK_JWKS_CACHE_SECONDS=300

# Public deployment (nginx/, docker-compose.prod.yml) — see docs/LIGHTSAIL-DEPLOY.md. Not used by
# plain `docker compose up`. deploy/lightsail/bootstrap.sh sets every var below FOR you from its
# --domain/--admin-ip/--postgres-*-port flags each run — no need to hand-edit these; they're
# documented here mainly so you know what the script is going to touch. It also overwrites
# KEYCLOAK_ISSUER_URL and TOOLS_MCP_RESOURCE_SERVER_URL above (both derived from the domains
# below) every run, so don't hand-edit those either once you're deploying with this script.
# MCP_DOMAIN=magicboto-mcp.rundotgames.xyz
# Public realm/OIDC endpoints via keycloak_public_proxy (not Keycloak's own admin port).
# KEYCLOAK_DOMAIN=magicboto-keycloak.rundotgames.xyz
# Admin-only: Keycloak admin console + REST API.
# KEYCLOAK_ADMIN_DOMAIN=magicboto-keycloak-admin.rundotgames.xyz
# Admin-only: Flower.
# FLOWER_DOMAIN=magicboto-flower.rundotgames.xyz
# Your IP (or a small CIDR) allowed through the *_ADMIN_DOMAIN / FLOWER_DOMAIN vhosts and the
# Postgres passthrough ports below. Everything else gets a 403/connection reset.
# ADMIN_ALLOWED_IP=
# Raw TCP passthrough ports for psql from an allow-listed IP (nginx stream — no hostname routing
# for non-HTTP, so these are ports, not the informational MCP_DOMAIN-style subdomains).
# POSTGRES_APP_PUBLIC_PORT=55432
# POSTGRES_KEYCLOAK_PUBLIC_PORT=55433

# Celery (tag sweep/audit pipelines). Required for tools_celery_worker + flower when using Compose.
# CELERY_REDIS_URL=redis://redis:6379/0
# CELERY_LOG_LEVEL=INFO
# Host port for Redis (default 6379).
# REDIS_LOCAL_PORT=6379
# Flower UI: container port and published host port (defaults 5555).
# FLOWER_PORT=5555
# FLOWER_LOCAL_PORT=5555
