# Copy to .env and adjust. Used by docker-compose, db/scripts, and api (OpenAPI pass-through to LM Studio).
# Run . .\db\scripts\load-db-env.ps1 to load these and set PG* for psql/pg_dump (no connection args needed).
POSTGRES_HOST=localhost
# LM Studio (OpenAI-compatible). API uses this for /openapi/v1/models and /openapi/v1/chat/completions.
# API in Docker + LM Studio on host → use host.docker.internal. API on host → use localhost.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234
# OpenAI-compatible API base URL. From UI container (Docker) use http://api:8000/openapi/v1. Used by api + ui/scripts/configure-chatraw.ps1.
OPENAPI_BASE_URL=http://api:8000/openapi/v1
# Chat UI URL for configure script (from host). Default matches docker-compose port 8080.
UI_BASE_URL=http://localhost:8080
# ChatRaw: model ID from LM Studio (used by ui/scripts/configure-chatraw.ps1 to set default in UI).
# CHATRAW_DEFAULT_MODEL_ID=
# API logging (loguru). Set LOG_LEVEL=DEBUG to see tool requests (e.g. get_card) in the card service.
# LOG_LEVEL=DEBUG
POSTGRES_USER=magicboto
POSTGRES_PASSWORD=magicboto
POSTGRES_DB=magicboto
POSTGRES_PORT=5432
