# Copy to .env and adjust. Loaded by the root-level env script only: . .\scripts\load-env.ps1
# After sourcing that, docker-compose, db scripts, and tools_api read from the environment.

# Tools API: container port (default 8000). Host port = TOOLS_API_LOCAL_PORT.
# TOOLS_API_PORT=8000
# TOOLS_API_LOCAL_PORT=8000
# MCP streamable HTTP: ``uv run uvicorn app.mcp.asgi:app`` (Docker Compose tools_mcp).
# Path defaults to /mcp (e.g. http://localhost:8765/mcp for MCP Inspector or desktop clients).
# TOOLS_MCP_HOST=0.0.0.0
# TOOLS_MCP_PORT=8765
# Browser MCP clients: comma-separated CORS origins, or * (default).
# TOOLS_MCP_CORS_ORIGINS=*
# Stdio MCP (local subprocess hosts only): uv run python -m app.mcp.main
# Host map for tools_mcp container (default 8765).
# TOOLS_MCP_LOCAL_PORT=8765
# MCP server id when registering this server in a host (e.g. Cursor); must match host config.
# TOOLS_MCP_SERVER_NAME=magic-boto-tools
# MCP Inspector (ghcr.io/modelcontextprotocol/inspector): host ports for UI and proxy.
# MCP_INSPECTOR_CLIENT_PORT=6274
# MCP_INSPECTOR_SERVER_PORT=6277
# After compose up: open http://localhost:${MCP_INSPECTOR_CLIENT_PORT:-6274} — use Streamable HTTP
# server URL http://tools_mcp:8765/mcp (not localhost:8765; proxy runs inside Docker).
# Logging (LOG_LEVEL=DEBUG for verbose tool requests).
# LOG_LEVEL=DEBUG
POSTGRES_HOST=localhost
POSTGRES_USER=magicboto
POSTGRES_PASSWORD=magicboto
POSTGRES_DB=magicboto
POSTGRES_PORT=5432
