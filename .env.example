# Copy to .env and adjust. This project does not load .env at runtime; set these variables in the
# environment (Docker Compose, your shell, CI, etc.) before running docker-compose, DB tasks, or tools_api.

# Tools API: container port (default 8000). Host port = TOOLS_API_LOCAL_PORT.
# TOOLS_API_PORT=8000
# TOOLS_API_LOCAL_PORT=8000
# MCP streamable HTTP: ``uv run uvicorn app.cmd.serve_mcp.asgi:app`` (Docker Compose tools_mcp).
# Path defaults to /mcp (e.g. http://localhost:8765/mcp for MCP Inspector or desktop clients).
# TOOLS_MCP_HOST=0.0.0.0
# TOOLS_MCP_PORT=8765
# Browser MCP clients: comma-separated CORS origins, or * (default).
# TOOLS_MCP_CORS_ORIGINS=*
# Stdio MCP (local subprocess hosts only): uv run python -m app.cmd.serve_mcp.stdio
# Host map for tools_mcp container (default 8765).
# TOOLS_MCP_LOCAL_PORT=8765
# MCP server id when registering this server in a host (e.g. Cursor); must match host config.
# TOOLS_MCP_SERVER_NAME=magic-boto-tools
# MCP Inspector (ghcr.io/modelcontextprotocol/inspector): host ports for UI and proxy.
# MCP_INSPECTOR_CLIENT_PORT=6274
# MCP_INSPECTOR_SERVER_PORT=6277
# After compose up: open http://localhost:${MCP_INSPECTOR_CLIENT_PORT:-6274} — use Streamable HTTP
# server URL http://tools_mcp:8765/mcp (not localhost:8765; proxy runs inside Docker).
# Logging (LOG_LEVEL=DEBUG for verbose tool requests).
# LOG_LEVEL=DEBUG
# Card carousel MCP UI: "v1" (default, paged) or "v2" (embla scroll-snap) — A/B switch.
# CARD_CAROUSEL_VARIANT=v1
POSTGRES_HOST=localhost
POSTGRES_USER=magicboto
POSTGRES_PASSWORD=magicboto
POSTGRES_DB=magicboto
POSTGRES_PORT=5432
# Required for tag sweep/audit (Anthropic Batch API).
ANTHROPIC_API_KEY=

# Authelia (auth) — shares the `postgres` service's magicboto_authelia database (see
# postgres/init-db.sh), no separate container. Run authelia\generate-secrets.ps1 to set these
# (it'll prompt for username/email) and everything else it generates — every actual secret: OIDC
# signing key, session/storage/HMAC secrets, client secret, admin password — lives as gitignored
# files under authelia/.secrets/ instead, never here. See AGENTS.md for the full setup flow.
# AUTHELIA_LOCAL_PORT=9091
# AUTHELIA_ADMIN_USERNAME=admin
# AUTHELIA_ADMIN_EMAIL=admin@example.com

# MCP resource-server auth (bearer JWTs, streamable HTTP only — stdio is never gated).
# Off by default; set true once the Authelia OIDC client is provisioned (see AGENTS.md / README).
# TOOLS_MCP_AUTH_ENABLED=false
# Externally reachable base URL of tools_mcp, used for RFC 9728 protected-resource metadata.
# TOOLS_MCP_RESOURCE_SERVER_URL=http://localhost:8765
# Comma-separated scopes required on every request (blank = accept any authenticated token).
# TOOLS_MCP_REQUIRED_SCOPES=
# Provider issuer as it appears in tokens' `iss` claim — the URL clients/tokens use, not the
# Docker-internal one.
# OIDC_ISSUER_URL=http://localhost:9091
# Expected `aud` claim; set to the confidential client's client ID (or a mapped audience).
# OIDC_AUDIENCE=magic-boto-tools-api
# Override only if tools_mcp can't reach OIDC_ISSUER_URL directly (e.g. Compose: the
# container reaches Authelia via its service name, not the host-mapped localhost port).
# OIDC_JWKS_URL=http://authelia:9091/jwks.json
# OIDC_JWKS_CACHE_SECONDS=300

# Celery (tag sweep/audit pipelines). Required for tools_celery_worker + flower when using Compose.
# CELERY_REDIS_URL=redis://redis:6379/0
# CELERY_LOG_LEVEL=INFO
# Host port for Redis (default 6379).
# REDIS_LOCAL_PORT=6379
# Flower UI: container port and published host port (defaults 5555).
# FLOWER_PORT=5555
# FLOWER_LOCAL_PORT=5555
