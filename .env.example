# Copy to .env and adjust. Loaded by the root-level env script only: . .\scripts\load-env.ps1
# After sourcing that, docker-compose, db scripts, tools_api, agent_api, and ui/scripts read from the environment.

# OpenAI-compatible proxy (e.g. LM Studio). agent_api uses this for /openapi/v1/models and chat.
# Agent in Docker + proxy on host → use host.docker.internal.
OPENAI_PROXY_BASE_URL=http://host.docker.internal:1234
# Tools API: container port (default 8000). Host port = TOOLS_API_LOCAL_PORT.
# TOOLS_API_PORT=8000
# TOOLS_API_LOCAL_PORT=8000
# Agent API: container port (default 8000). Host port = AGENT_LOCAL_PORT (default 8001).
# AGENT_API_PORT=8000
# AGENT_LOCAL_PORT=8001
# Local invoke serve only: port for agent uvicorn (default 8001 so tools_api can use 8000).
# AGENT_PORT=8001
# Host port for the UI container. configure-chatraw.ps1 uses localhost:UI_LOCAL_PORT.
# UI_LOCAL_PORT=8080
# ChatRaw default model ID (optional). Used by ui/scripts/configure-chatraw.ps1.
# CHATRAW_DEFAULT_MODEL_ID=
# Logging (LOG_LEVEL=DEBUG for tool requests).
# LOG_LEVEL=DEBUG
# OPENAI_PROXY_MODEL=claude-sonnet-4-6
# OPENAI_PROXY_API_KEY=SUPER_SECRET_KEY
POSTGRES_HOST=localhost
POSTGRES_USER=magicboto
POSTGRES_PASSWORD=magicboto
POSTGRES_DB=magicboto
POSTGRES_PORT=5432
